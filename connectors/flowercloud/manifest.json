{
    "id": "flowercloud",
    "provider": "flowercloud",
    "capabilities": ["session"],
    "auth": {
        "method": "web_login",
        "secret_name": "SESSION_COOKIE",
        "login_url": "https://api-flowercloud.com/clientarea.php"
    },
    "parameters": [
        {
            "name": "SESSION_COOKIE",
            "type": "secret",
            "required": true,
            "label": "FlowerCloud Session Cookie",
            "label@zh-Hans": "花云网页会话 Cookie",
            "exposeToScript": true
        }
    ],
    "endpoints": {
        "default": "https://api-flowercloud.com",
        "login": "https://api-flowercloud.com/clientarea.php"
    },
    "loginDomains": ["api-flowercloud.com", "flower.yt", "flowercloud.net"],
    "cookieNames": ["*"],
    "script": "connector.ts"
}
