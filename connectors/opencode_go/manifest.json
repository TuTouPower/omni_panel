{
    "id": "opencode_go",
    "provider": "opencode_go",
    "capabilities": ["session"],
    "auth": {
        "method": "web_login",
        "secret_name": "SESSION_COOKIE",
        "login_url": "https://opencode.ai/console/login"
    },
    "parameters": [
        {
            "name": "SESSION_COOKIE",
            "type": "secret",
            "required": true,
            "label": "Session Cookie",
            "label@zh-Hans": "登录 Cookie",
            "exposeToScript": true
        }
    ],
    "endpoints": {
        "default": "https://opencode.ai",
        "console": "https://opencode.ai/console",
        "login": "https://opencode.ai/console/login"
    },
    "loginDomains": ["opencode.ai"],
    "cookieNames": ["__Host-console_session", "auth"],
    "script": "connector.ts"
}
