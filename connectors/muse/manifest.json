{
    "id": "muse",
    "provider": "muse",
    "capabilities": ["session"],
    "auth": {
        "method": "web_login",
        "secret_name": "SESSION_COOKIE",
        "login_url": "https://muse.ai/"
    },
    "parameters": [
        {
            "name": "SESSION_COOKIE",
            "type": "secret",
            "required": true,
            "label": "Muse Session Cookie",
            "label@zh-Hans": "Muse 会话 Cookie",
            "exposeToScript": true
        },
        {
            "name": "ACTION_ID",
            "type": "string",
            "required": false,
            "label": "Next.js Server Action ID override",
            "label@zh-Hans": "Server Action ID 覆盖（可选）",
            "exposeToScript": true
        },
        {
            "name": "DEPLOYMENT_ID",
            "type": "string",
            "required": false,
            "label": "Next.js Deployment ID override",
            "label@zh-Hans": "Deployment ID 覆盖（可选）",
            "exposeToScript": true
        }
    ],
    "endpoints": {
        "default": "https://muse.ai",
        "login": "https://muse.ai/"
    },
    "loginDomains": ["muse.ai", "auth.muse.ai"],
    "cookieNames": ["hatch_sess"],
    "script": "connector.ts"
}
