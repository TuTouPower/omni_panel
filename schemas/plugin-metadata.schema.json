{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "number"
        },
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "icon": {
            "type": "string"
        },
        "parameters": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "string",
                            "secret",
                            "integer",
                            "boolean",
                            "choice",
                            "directory",
                            "file"
                        ]
                    },
                    "required": {
                        "type": "boolean"
                    },
                    "placeholder": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "defaultValue": {
                        "type": "string"
                    },
                    "options": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "label": {
                                    "type": "string"
                                },
                                "value": {
                                    "type": "string"
                                },
                                "label@zh-Hans": {
                                    "type": "string"
                                },
                                "label@en": {
                                    "type": "string"
                                }
                            },
                            "required": ["label", "value"],
                            "additionalProperties": false
                        }
                    },
                    "label@zh-Hans": {
                        "type": "string"
                    },
                    "label@en": {
                        "type": "string"
                    },
                    "description@zh-Hans": {
                        "type": "string"
                    },
                    "description@en": {
                        "type": "string"
                    }
                },
                "required": ["name", "label", "type", "required"],
                "additionalProperties": false
            }
        },
        "endpoints": {
            "type": "object",
            "additionalProperties": {
                "anyOf": [
                    {
                        "type": "string",
                        "format": "uri"
                    },
                    {
                        "type": "null"
                    }
                ]
            }
        },
        "supportedProviders": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
            }
        },
        "defaultSource": {
            "type": "string",
            "enum": ["poll", "local", "session", "wrapper", "probe", "gateway"]
        },
        "login_url": {
            "type": "string",
            "format": "uri"
        },
        "cookie_names": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "auth": {
            "type": "object",
            "properties": {
                "method": {
                    "type": "string",
                    "enum": ["apikey", "oauth_device", "web_login", "cpa_mgmt", "local_cli"]
                },
                "secret_name": {
                    "type": "string",
                    "minLength": 1
                },
                "extra_fields": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "login_url": {
                    "type": "string",
                    "format": "uri"
                },
                "require_endpoint": {
                    "type": "boolean"
                }
            },
            "required": ["method", "secret_name"],
            "additionalProperties": false
        },
        "name@zh-Hans": {
            "type": "string"
        },
        "name@en": {
            "type": "string"
        },
        "description@zh-Hans": {
            "type": "string"
        },
        "description@en": {
            "type": "string"
        }
    },
    "additionalProperties": false
}
