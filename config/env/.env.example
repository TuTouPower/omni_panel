# Live contract test credentials & local development settings
# ─────────────────────────────────────────────────────────────
# 1. API 密钥类连接器 (API Key Authenticated Connectors)
DEEPSEEK_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
TIKHUB_TOKEN=
GETONEAPI_KEY=
GETONEAPI_BASE_URL=

# 2. CPA 管理网关连接器 (CPA Manager)
CPA_MGMT_URL=
CPA_MGMT_KEY=

# 3. 本地 CLI 授权连接器 (Local CLI Authenticated - 自动探测本地授权文件，无需填环境变量)
# - Claude: ~/.claude/.credentials.json
# - Codex: ~/.codex/auth.json
# - Antigravity: ~/.antigravity/session.json
# - Command Code: ~/.commandcode/auth.json

# 4. OAuth 与网页登录类连接器 (Interactive OAuth & Web Login - 界面交互授权，无需填环境变量)
# - Grok: OAuth Device Flow (设备码交互授权)
# - Grok Bot: 浏览器 PKCE 授权登录
# - Kimi: OAuth Device Flow (设备码交互授权)
# - Kimi Web: 网页登录 Cookie 授权
# - MiMo: 网页登录 Cookie 授权
# - Muse AI: 网页登录 Cookie 授权
# - OpenCode Go: 网页登录 Cookie 授权

# 5. 可选插件与全局运行时覆盖 (Optional Runtime Overrides)
OMNI_PLUGIN_PROXY=
OMNI_PLUGIN_ENDPOINTS=
OMNI_PANEL_PORT=17863
